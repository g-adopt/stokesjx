    authors:
      - family-names: Hager
        given-names: Bradford H.
      - family-names: O'Connell
        given-names: Richard J.
    title: "A simple global model of plate dynamics and mantle convection"
    journal: "Journal of Geophysical Research: Solid Earth"
    volume: 86
    issue: B6
    start: 4843
    end: 4867
    year: 1981
    doi: 10.1029/JB086iB06p04843
  - type: article
